# Turso Database
TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Comma-separated list of LINE user IDs and/or group IDs to send monthly shift reminders to.
# User IDs start with "U", group IDs start with "C".
LINE_RECIPIENT_IDS=Uxxxxxxxxxxxxxxxx,Cxxxxxxxxxxxxxxxx

# Secret token to protect the Vercel Cron endpoint from unauthorized calls.
# Vercel Cron automatically includes Authorization: Bearer <CRON_SECRET> in the request.
CRON_SECRET=any-random-string
